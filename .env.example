# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=computator
PORT=5901

# Database URIs
MONGO_URI=mongodb://localhost:27017/governify
REDIS_URI=redis://localhost:6379

# JWT configuration
JWT_SECRET=governify_secret_key

# Redis settings
REDIS_ENABLED=true
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY_MS=2000
REDIS_SLOW_RECONNECTION_MAX_RETRIES=10
REDIS_SLOW_RECONNECTION_STRATEGY=true
REDIS_RETRY_SLOW_DELAY_MS=10000