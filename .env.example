# Service configuration
NODE_ENV=development
GOV_LOG_LEVEL=INFO
GOV_SERVICE_NAME=computer
PORT=5903

# Internal service URLs
AUTHENTICATOR_SERVICE_URL=http://localhost:5900
FETCHER_SERVICE_URL=http://localhost:5904

# Database URIs
MONGO_URI=mongodb://localhost:27017/governify-next
REDIS_URI=redis://localhost:6379

# JWT configuration
CLIENT_ID=computer
CLIENT_SECRET=computer_client_secret
JWT_SECRET=governify_next_secret_key
JWT_ISSUER=authenticator
JWT_AUDIENCE=governify-next

# Redis settings
REDIS_ENABLED=false
REDIS_MAX_RETRIES=5
REDIS_RETRY_DELAY_MS=2000
REDIS_SLOW_RECONNECTION_MAX_RETRIES=10
REDIS_SLOW_RECONNECTION_STRATEGY=false
REDIS_RETRY_SLOW_DELAY_MS=10000

# Fetch Result polling configuration
FETCH_RESULT_POLLING_MAX_ATTEMPTS=300
FETCH_RESULT_POLLING_INTERVAL_MS=1000